# Independent Docker metadata-only deployment. Never commit real RTSP URLs,
# tenant identifiers, credentials, or tokens in this file.
ANNOTATOR_RUNTIME_MODE=metadata_only
ANNOTATOR_BIND_HOST=0.0.0.0
ANNOTATOR_PORT=18080
ANNOTATOR_HOST_PORT=18080

# VMS-style canonical ID and the host-published VMS MediaMTX RTSP path.
ANNOTATOR_CAMERA_ID=cam_01
ANNOTATOR_CAMERA_NAME=VMS Camera 01
ANNOTATOR_CAMERA_RTSP_URL=rtsp://host.docker.internal:8554/<tenant>/<nvr-id>_ch_01

# Explicit TensorRT means startup fails if the mounted engine cannot load.
ANNOTATOR_DETECTION_BACKEND=tensorrt
ANNOTATOR_DETECTION_PRECISION=fp16
ANNOTATOR_MODEL_PATH=models/yolo11n.pt
ANNOTATOR_TRT_ENGINE_MODEL=models/yolo11n_640_fp16.engine
ANNOTATOR_CAPTURE_FPS=3
ANNOTATOR_INFERENCE_FPS=3
ANNOTATOR_PREDICTION_FPS=5
ANNOTATOR_CONFIDENCE=0.40

# Part 4A gateway-only mode (use docker-compose.gateway.yml; no RTSP, GPU,
# TensorRT, model, or engine values are used in that image).
# ANNOTATOR_RUNTIME_MODE=gateway_only
# ANNOTATOR_ALLOWED_CAMERA_IDS=cam_03
# METADATA_TTL_MS=2000
# ANNOTATOR_INGEST_TOKEN=replace-with-local-producer-token
