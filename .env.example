# Define only the variables referenced by enabled camera URLs in the selected
# YAML file. Names are configuration-defined; these are examples only.
# Never commit real credentials.
OFFICE_ENTRY_URL=rtsp://camera-host.example/office-entry
LOADING_BAY_URL=rtsp://camera-host.example/loading-bay

# Change this to the LAN address when browsers connect from another machine.
PUBLIC_HOST=127.0.0.1
MEDIAMTX_BIN=mediamtx
# Optional isolated AI controls; restart after changing them.
# Supported backends: pytorch | onnx | tensorrt | auto
# Do not select the failed INT8 ONNX model.
DETECTION_BACKEND=tensorrt
DETECTION_PRECISION=fp16
AI_CAPTURE_FPS=3
YOLO_INFERENCE_FPS=2
BYTETRACK_PREDICTION_FPS=10
# Native TensorRT FP16 engine (build with ./scripts/export_yolo_trt.sh; ignored by Git).
TRT_ENGINE_MODEL=models/yolo11n_640_fp16.engine
